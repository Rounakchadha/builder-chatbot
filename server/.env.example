# Server
PORT=8080
NODE_ENV=development
CORS_ALLOWED_ORIGINS=https://www.finfinity.co.in,http://localhost:5173

# Postgres
DATABASE_URL=postgresql://loanbot:loanbot@localhost:5432/loanbot

# Redis
REDIS_URL=redis://localhost:6379

# Secrets — never commit real values. In prod these come from AWS/GCP Secret Manager.
SESSION_HMAC_SECRET=dev-only-change-me
PII_ENCRYPTION_KEY=dev-only-32-byte-key-change-me!!

# Real Finfinity backend — one base URL serves every real integration point (dedupe, PAN lookup,
# OTP, bureau, lead creation, lender offers, status). Leave blank to keep every service on its
# deterministic mock. See server/src/services/finfinityClient.ts.
# There's no separate login/token to configure here — a successful OTP verify (and again a bureau
# verify) returns its own access token right in the response, which the flow carries forward
# per-conversation for every later authenticated call. See finfinityClient.ts's doc comment.
#   UAT  : https://backend.uatfinfinity.in/api/v1
#   Prod : https://bev3.finfinity.co.in/api/v1
FINFINITY_API_BASE_URL=
# Separate opt-in: getcustomeroffers (lender offers) — see eligibility.service.ts.
FINFINITY_OFFERS_ENABLED=false

# Standalone Personal Loan eligibility pre-check (separate service/repo) — see
# FINFINITY-BRE-MAIN/pl-eligibility-precheck. Leave blank to keep personalLoanEligibility.service.ts
# on its "always eligible" mock.
PL_ELIGIBILITY_SERVICE_URL=http://localhost:8095

# Standalone Home Loan eligibility pre-check (separate service/repo, 21 real lenders) — see
# FINFINITY-BRE-MAIN/hl-eligibility-precheck. Leave blank to keep homeLoanEligibility.service.ts
# on its "always eligible" mock.
HL_ELIGIBILITY_SERVICE_URL=http://localhost:8096

# RM summary email — sends the customer's contact details + selected product to their assigned RM
# once a lead exists. Leave blank to keep email.service.ts on a log-only mock (no real send).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Shared secret for /admin/* routes (currently just /admin/pl-bre-comparison) — pass it as
# ?token=... or an x-admin-token header. Leave blank in development for unauthenticated local
# access; MUST be set to a real random value before any non-development deploy, or every /admin/*
# request is refused outright.
ADMIN_TOKEN=change-me-to-a-real-random-value
