generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One chat session = one visitor's attempt at the flow. Anonymous until
/// mobile is verified; may never be tied to a real identity (no-PAN path).
model Conversation {
  id            String   @id @default(uuid())
  sessionToken  String   @unique
  flowId        String // e.g. "home_loan_v1" — which flow config drove this session
  currentStepId String?
  mobileHash    String? // HMAC of verified mobile, never plaintext
  mobileMasked  String? // e.g. "9876X XXXX0", safe to display/log
  customerId    String? // set once the dedupe check matches, or a new Customer is created
  // Security-review finding, 2026-10-23: no onDelete policy — deleting a Customer with existing
  // Conversations pointing at it would fail outright with a foreign-key error instead of either
  // cascading or clearing the link. SetNull (not Cascade): a Conversation is its own real record
  // worth keeping even if the Customer it once matched is later removed.
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  panConsent    Boolean?
  status        String   @default("in_progress") // in_progress | completed | abandoned
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages         Message[]
  answers          FlowAnswer[]
  lead             Lead?
  consentEvents    ConsentAudit[]
  plBreComparisons PlBreComparison[]
  hlBreComparisons HlBreComparison[]

  @@index([mobileHash])
  @@index([status])
  // Security-review finding, 2026-10-23: loadSession's new 30-day age cutoff (see
  // session.service.ts's SESSION_MAX_AGE_MS) and any future cleanup job both need to scan by age —
  // with no index here that was a full table scan.
  @@index([createdAt])
}

/// A known, deduped identity — the record the Dedupe API is checked against on every new
/// conversation (by mobileHash), and the record a not-yet-known customer gets created into once
/// PAN + bureau consent are collected. Distinct from Lead: a Customer can exist (and be reused
/// across multiple conversations/loan applications over time) with no Lead ever created for them.
model Customer {
  id            String   @id @default(uuid())
  mobileHash    String   @unique
  mobileMasked  String
  panEncrypted  String? // AES-256-GCM ciphertext, never plaintext
  panMasked     String?
  nameEncrypted String?
  dob           String?
  email         String?
  pincode       String?
  segment       String?
  creditScore   Int?
  bureauSource  String? // "bureau" | "experian" — which pull last populated creditScore
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  conversations Conversation[]
}

/// Full transcript, for RM/analyst visibility and LLM context windowing.
model Message {
  id             String       @id @default(uuid())
  conversationId String
  // Security-review finding, 2026-10-23: no onDelete policy — a transcript has no independent
  // reason to exist once its Conversation is gone, so it should disappear with it rather than
  // blocking the delete with a foreign-key error.
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // bot | user | system
  stepId         String?
  text           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

/// Slot store — the source of truth for collected answers, keyed by step id.
/// Deliberately separate from Message so the flow engine never has to parse
/// free-text chat history to know what it already knows.
model FlowAnswer {
  id             String       @id @default(uuid())
  conversationId String
  // Same reasoning as Message's onDelete above.
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  stepId         String
  value          Json
  createdAt      DateTime     @default(now())

  @@unique([conversationId, stepId])
}

/// Created only when panConsent = true AND the CIBIL pull succeeds.
model Lead {
  id                String       @id @default(uuid())
  conversationId    String       @unique
  // Same reasoning as Message's onDelete above — a Lead has no reason to outlive its Conversation.
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  panEncrypted      String // AES-256-GCM ciphertext, never plaintext
  panMasked         String // e.g. "ABCDE****F"
  nameEncrypted     String?
  creditScore       Int?
  builderLeadId     String? // id returned by the Builder module once wired up
  builderSyncStatus String       @default("pending") // pending | synced | failed
  createdAt         DateTime     @default(now())

  // Added 2026-10-31 (bug fix): "Start over"/a brand-new session for a RETURNING real customer had
  // no way to tell "this exact person already has a real lead for this exact product" across
  // conversations — Lead.conversationId's uniqueness only ever stopped a SECOND lead within the
  // SAME conversation. remoteCustomerId is the real Finfinity backend's own customer_id (always set
  // for a real, non-mock customer — see ctx.answers.remoteCustomerId), which stays the same across
  // every conversation for the same person, unlike the local mock-only Customer.id. product is the
  // flow's own product string (e.g. "Home loan", "Personal Loan") — every product branch lives in
  // ONE shared Conversation.flowId, so flowId alone can't distinguish them. Together these let
  // ensureLeadOnce (lead.service.ts) find and reuse an already-created real lead instead of calling
  // create_anacity_lead (and triggering a fresh RM-assignment email to Sparsh) a second time for the
  // same person+product.
  remoteCustomerId Int?
  product          String?

  // Added 2026-10-31 (bug fix, same report as above): the RM-summary email (routes/chat.ts,
  // emailService.sendRmSummary — our OWN code, not a Finfinity-side effect) was guarded by
  // ctx.answers.rmSummaryEmailSent, which only prevents a re-send within the SAME conversation
  // (re-renders of the same result step). A brand-new conversation for a returning customer starts
  // with that flag unset, so even once the lead-reuse fix above stopped creating duplicate real
  // leads, every "Start over" still fired a fresh email — confirmed live: lead dedupe worked (same
  // builderLeadId reused 5 times) but the email still went out each time. This flag is checked
  // across EVERY conversation sharing the same remoteCustomerId+product (see
  // hasRmSummaryEmailAlreadySent/markRmSummaryEmailSent in lead.service.ts), not just this one.
  rmEmailSent Boolean @default(false)

  // Added 2026-11-10 (bug fix): syncing financials (updateLead/updateCustomer) onto a REUSED lead
  // was skipped entirely (see ensureLead's own comment in flows/homeLoan.ts) to stop the
  // RM-notification spam above — but that also meant a returning customer's CURRENT income/EMI
  // never reached Finfinity at all, so getcustomeroffers kept answering with whatever was on file
  // from the very first time this lead was created, no matter how many times they'd since updated
  // it. Confirmed live (2026-11-10): a customer who'd edited income down to ₹30,000 still got
  // eligibility computed against the original ₹4,00,000. Fix: only skip the sync when nothing in
  // this snapshot has actually changed since the last successful sync — a genuine change still
  // syncs (and still notifies the RM, correctly, since something real actually changed), only a
  // byte-for-byte-identical revisit (e.g. five "Start over" clicks in a row, which is what the
  // original 2026-10-31 bug report actually was) skips it. JSON of every field pushed by
  // syncLeadFinancials (see that function), null until the first successful sync.
  lastSyncedFinancialsJson String?

  // Security-review finding, 2026-10-23: listApplications (routes/chat.ts) and ensureLead's own
  // P2002-recovery lookup both query by builderLeadId-adjacent patterns and by this id directly in
  // status lookups — no index meant a full table scan as Lead rows grow.
  @@index([builderLeadId])
  // ensureLeadOnce's cross-conversation dedupe query, added 2026-10-31 — see remoteCustomerId above.
  @@index([remoteCustomerId, product])
}

/// Personal Loan only (2026-10-21) — every time the real Finfinity financer chain computes offers,
/// our own standalone pre-check BRE (personalLoanEligibility.service.ts) is run in the background
/// on the exact same facts, purely for comparison — never shown to the customer, never affects
/// what they see. Persisted (not just logged) so this survives a server restart and can actually be
/// reviewed later to calibrate/improve our own BRE against real-world outcomes, per direct
/// instruction: "save the info from their apis and test it against our BRE."
model PlBreComparison {
  id              String       @id @default(uuid())
  conversationId  String
  // Same reasoning as Message's onDelete above.
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  leadId          String?
  facts           Json // the shared PlEligibilityFacts both engines were run against
  // PlLenderComparisonResult[] (see flows/personalLoan.ts) — ALL 3 lenders each engine attempted,
  // eligible or not, with whatever rejection reason + raw per-lender payload was available. Was
  // just the approved-offer list (no reasons, no record a rejected lender was even checked) —
  // widened 2026-10-24 so a shadow-mode comparison can actually say *why* the two engines disagree.
  realChainResults Json // financerwiseeligibility's (Bitsflow) per-lender outcome
  ownBreResults    Json // our pre-check microservice's per-lender outcome
  createdAt       DateTime     @default(now())

  @@index([conversationId])
}

/// Home Loan only (2026-10-28) — same shadow-comparison discipline as PlBreComparison above:
/// every time the real Finfinity getcustomeroffers call computes offers, our own standalone
/// pre-check BRE (homeLoanEligibility.service.ts, FINFINITY-BRE-MAIN/hl-eligibility-precheck) is
/// run in the background on the same facts, purely for comparison — never shown to the customer,
/// never affects what they see. `realChainResults` only ever has the ELIGIBLE side (`offers`) —
/// getcustomeroffers's own `rejected_lender_list` isn't threaded through eligibility.service.ts's
/// return type today, so a true full reject-vs-reject comparison isn't possible yet from here.
model HlBreComparison {
  id              String       @id @default(uuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  leadId          String?
  facts           Json // the shared HlEligibilityFacts both engines were run against
  realChainResults Json // getcustomeroffers's (Bitsflow) eligible-lender list only (see note above)
  ownBreResults    Json // our pre-check microservice's per-lender outcome, eligible AND rejected
  createdAt       DateTime     @default(now())

  @@index([conversationId])
}

/// Immutable record of every PAN-consent decision, for compliance.
model ConsentAudit {
  id             String       @id @default(uuid())
  conversationId String
  // Same reasoning as Message's onDelete above.
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  decision       Boolean
  // Security-review finding, 2026-10-23: a resumed remembered-identity session used to write a row
  // here identical to a real PAN-consent click (decision: true, no way to tell them apart) even
  // though no consent decision actually happened in that session — it was inferred from an earlier
  // one. `source` distinguishes the two: 'mobile_step' is a real consent click, 'identity_resume' is
  // this session re-asserting a PRIOR session's consent, not a new decision.
  source         String       @default("mobile_step")
  ipAddress      String
  userAgent      String?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

/// Curated FAQ knowledge base for the RAG-grounded FAQ answers. Embeddings
/// are stored as a float array; a pgvector column is added via raw SQL
/// migration (see migrations/) since Prisma doesn't model `vector` natively.
model KnowledgeChunk {
  id        String   @id @default(uuid())
  topic     String // e.g. "foir", "emi", "home_loan_basics"
  content   String
  version   Int      @default(1)
  createdAt DateTime @default(now())
}
